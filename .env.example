# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (test mode: Developers -> API keys) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (email) ---
RESEND_API_KEY=re_...
# Must be on a domain verified in Resend. For quick testing: onboarding@resend.dev
EMAIL_FROM="Sellify <bookings@yourdomain.com>"

# --- OpenAI (AI store customizer) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=

# --- Vercel API (custom domains for stores) ---
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Domains ---
# Leave empty to run on the Vercel default domain: stores at <APP_URL>/s/<slug>.
# Set to a domain on Vercel nameservers for stores at <slug>.<root> and backend at app.<root>.
STORES_ROOT_DOMAIN=
APP_URL=http://localhost:3000
